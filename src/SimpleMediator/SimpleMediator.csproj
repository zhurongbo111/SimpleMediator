<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SimpleMediator</RootNamespace>
    <PackageId>SimpleMediator</PackageId>
    <Version>1.0.0</Version>
    <Authors>SimpleMediator Contributors</Authors>
    <Description>A lightweight mediator pattern implementation for .NET 8+ with request/response, notifications, pipeline behaviors, and DI integration.</Description>
    <PackageTags>mediator;cqrs;pipeline;dotnet;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/user/simple-mediator</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>True</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
